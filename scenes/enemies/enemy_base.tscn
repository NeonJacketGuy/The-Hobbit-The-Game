[gd_scene format=3 uid="uid://cp62qefijf182"]

[ext_resource type="Texture2D" uid="uid://wlbodjxbqix8" path="res://icon.svg" id="1_qty17"]

[sub_resource type="GDScript" id="GDScript_qty17"]
script/source = "extends CharacterBody2D
class player:
	pass

@export var move_speed := 200.0
var is_stabbing := false

func _physics_process(_delta: float) -> void:
	
	velocity.x = move_speed
	velocity.y = move_speed
	
	move_and_slide()

func _process(_delta: float) -> void:
		if is_stabbing == false:
			%Attack.rotation = ( get_global_mouse_position() - global_position).angle() + deg_to_rad(0)

func attack():
	if is_stabbing == true:
		pass
	else:
		%ColorRect.color = Color(1.0, 0.0, 0.0)
		%CollisionShape2D.disabled = false
		is_stabbing == true
		%Attacking.start()
		%AttackLength.start()

func _on_attack_timer_timeout() -> void:
	is_stabbing = false
	attack()


func _on_attack_length_timeout() -> void:
	%ColorRect.color = Color(1.0, 1.0, 1.0, 1.0)
	%CollisionShape2D.disabled = true
"

