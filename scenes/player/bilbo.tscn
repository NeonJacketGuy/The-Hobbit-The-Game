[sub_resource type="GDScript" id="GDScript_5208v"]
script/source = "extends CharacterBody2D

@export var move_speed = 220.0
var draw_time = 3
var armed := false
var can_interact := true
var is_stabbing = false
var hiding = false
var have_ring = false
var visible_to_enemy = 1
var step_time = 0
var step_volume = 2

func _physics_process(_delta: float) -> void:
	
	if velocity.x != 0:
		step()
	elif velocity.y != 0:
		step()
	elif step_time >= 0:
		still()
	
	
	move_and_slide()

func _process(_delta: float) -> void:
	can_interact =! armed
	if Input.is_action_just_pressed(\"Interact\"):
		if armed == true:
			pass
	
	if is_stabbing == false:
		%Sword.rotation = ( get_global_mouse_position() - global_position).angle() + deg_to_rad(0)
	
	print(visible_to_enemy)

func _input(_event) -> void:
	var direction_x := Input.get_axis(\"Move_Left\",  \"Move_Right\")
	
	velocity.x = direction_x * move_speed
	var direction_y := Input.get_axis(\"Move_Up\",\"Move_Down\")
	
	velocity.y = direction_y * move_speed
	
	if Input.is_action_just_pressed(\"Arm_Yourself\"):
		if armed == false:
			armed = true
			%ColorRect.visible = true
			%CollisionShape2D.disabled = false
			visible_to_enemy += 0.75
		elif armed == true:
			armed = false
			%ColorRect.visible = false
			%CollisionShape2D.disabled = true
			visible_to_enemy -= 0.75
	
	if Input.is_action_just_pressed(\"Interact\"):
		if can_interact == true:
			pass
		elif armed == true:
			if is_stabbing == false:
				%CollisionShape2D.position.x += 5
				%ColorRect.position.x += 5
				is_stabbing = true
				
				%TimeToStab.start()
	if Input.is_action_just_pressed(\"Hide\"):
		if hiding == false:
			hideing()
	if Input.is_action_just_released(\"Hide\"):
		if hiding == true:
			reveal()

func _on_time_to_stab_timeout() -> void:
	%CollisionShape2D.position.x -= 5
	%ColorRect.position.x -= 5
	is_stabbing = false

func hideing():
	if have_ring == true:
		%Sprite2D.visible = false
		visible_to_enemy -= 1
		hiding = true
		step_volume = 1
		move_speed = 110
	else:
		%Sprite2D.modulate = Color(1.0, 1.0, 1.0, 0.5)
		visible_to_enemy -= 0.5
		hiding = true
		step_volume = 1
		move_speed = 110

func reveal():
	if have_ring == true:
		%Sprite2D.visible = true
		visible_to_enemy += 1
		hiding = false
		step_volume = 2
		move_speed = 220
	else:
		%Sprite2D.modulate = Color(1.0, 1.0, 1.0, 1.0)
		visible_to_enemy += 0.5
		hiding = false
		step_volume = 2
		move_speed = 220

func step():
	if visible_to_enemy <= 2:
		visible_to_enemy += 0.001 * step_volume
		step_time += 0.001 * step_volume

func still():
	visible_to_enemy -= step_time
	step_time = 0
"

