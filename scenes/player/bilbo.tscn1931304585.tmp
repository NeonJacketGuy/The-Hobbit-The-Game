[gd_scene format=3 uid="uid://dr6n85ea8ee88"]

[sub_resource type="GDScript" id="GDScript_5208v"]
script/source = "extends CharacterBody2D

@export var move_speed := 220.0
var draw_time = 3

func _physics_process(_delta: float) -> void:
	
	var direction_x := Input.get_axis(\"Move_Left\",  \"Move_Right\")
	velocity.x = direction_x * move_speed
	var direction_y := Input.get_axis(\"Move_Up\",\"Move_Down\")
	velocity.y = direction_y * move_speed

	move_and_slide()

func _process(_delta: float) -> void:
	var sword_drawn := false
	if Input.is_action_just_pressed(\"Interact\"):
			print(\"holding handle\")
			%DrawTime.start()
	if Input.is_action_just_pressed(\"Interact\"):
		if draw_time >= 3:
			if sword_drawn == false:
				sword_drawn = true
				print(\"sword drawn\")
				%DrawTime.stop()
				draw_time = 0
			else:
				sword_drawn = false
				print(\"sword sheathed\")
				%DrawTime.stop()
				draw_time = 0
		else:
			%DrawTime.stop()
			draw_time = 0
			print(\"failed to draw sword\")
	else:
		print(\"failed to attempt to draw sword\")


func _on_draw_time_timeout() -> void:
	draw_time += 1
	print(\"actively drawing sowrd\")
"

